<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ordens de Serviço</title>
    <link rel="stylesheet" href="/styles/orders.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script> <!-- Inclua o jQuery -->
    <script>
        // Função para filtrar a tabela por status na coluna "Tempo" e atualizar o status
        function handleAction(action, orderId, statusText, statusColor, differenceInDays) {
            if (action === "filter") {
                let table = document.getElementById("ordersTable"), rows = table.getElementsByTagName("tr");
                for (let i = 1; i < rows.length; i++) {
                    let tempoCell = rows[i].getElementsByTagName("td")[8];
                    if (tempoCell) {
                        let tempoText = tempoCell.textContent || tempoCell.innerText;
                        rows[i].style.display = (statusText === "todos" || tempoText.includes(statusText)) ? "" : "none";
                    }
                }
            } else if (action === "updateStatus") {
                let statusHTML = `<span class="bullet ${statusColor}"></span> ${statusText} (${differenceInDays} dia${differenceInDays === 1 ? '' : 's'})`;
                document.getElementById('status_' + orderId).innerHTML = statusHTML;
            }
        }
    </script>
</head>
<body>
    <h2>Ordens de Serviço</h2>

    <!-- Botões para seleção de filtro -->
    <div class="filter-buttons">
        <button onclick="handleAction('filter', null, 'todos')">Todos</button>
        <button onclick="handleAction('filter', null, 'Aprovado')">Aprovado</button>
        <button onclick="handleAction('filter', null, 'Recusado')">Não Aprovado</button>
        <button onclick="handleAction('filter', null, 'Pronto')">Finalizado</button>
    </div>
    
    <table id="ordersTable">
        <thead>
            <tr>
                <th>ID</th> 
                <th>Número da Ordem</th>
                <th>Nome do Cliente</th>
                <th>Telefone</th>
                <th>Data</th>
                <th>Produto</th>
                <th>Valor do Reparo</th>
                <th>Descrição do Produto</th>
                <th>Tempo</th>
                <th>Aprovado</th>
                <th>Editar</th>
            </tr>
        </thead>
        <tbody>
            <% orders.forEach(order => { %>
            <% let currentDate = new Date(), orderDate = new Date(order.date); %>
            <% let differenceInDays = Math.ceil((currentDate - orderDate) / (1000 * 60 * 60 * 24)); %>
            <tr>
                <td><%= order.id %></td>
                <td><%= order.orderNumber %></td>
                <td><%= order.customerName %></td>
                <td><%= order.telephone %></td>
                <td><%= order.date %></td>
                <td><%= order.product %></td>
                <td>R$ <%= order.repairCost %></td>
                <td><%= order.description || '' %></td>
                <td id="status_<%= order.id %>">
                    <div class="status <%= differenceInDays <= 3 ? 'green' : differenceInDays <= 5 ? 'orange' : 'red' %>"></div>
                    <% if (differenceInDays <= 3) { %>
                        Verificar (<%= differenceInDays  %> dia<%= differenceInDays === 1 ? '' : 's' %>)
                    <% } else if (differenceInDays <= 5) { %>
                        Verificar (atraso de <%= differenceInDays  %> dia<%= differenceInDays === 1 ? '' : 's' %>)
                    <% } else { %>
                        Verificar (atraso de <%= differenceInDays  %> dia<%= differenceInDays === 1 ? '' : 's' %>)
                    <% } %>
                </td>
                <td>
                    <label>
                        <input type="radio" name="approval_<%= order.id %>" value="aprovado" onclick="handleAction('updateStatus', <%= order.id %>, 'Aprovado', 'green', <%= differenceInDays %>)"> Aprovado
                    </label>
                    <br>
                    <label>
                        <input type="radio" name="approval_<%= order.id %>" value="nao_aprovado" onclick="handleAction('updateStatus', <%= order.id %>, 'Recusado', 'red', <%= differenceInDays %>)"> Recusado 
                    </label>
                    <br>
                    <label>
                        <input type="radio" name="approval_<%= order.id %>" value="finalizado" onclick="handleAction('updateStatus', <%= order.id %>, 'Pronto', 'blue', <%= differenceInDays %>)"> Pronto
                    </label>
                </td>
                <td>
                    <a href="/edit/<%= order.id %>"><button>Editar</button></a> <!-- Botão Editar -->
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
    <a href="/"><button>Adicionar nova ordem</button></a>
</body>
</html>
